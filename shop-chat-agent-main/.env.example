# Anthropic Claude API Key
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY

# OpenAI is used only for customer artwork generation.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Railway: mount a persistent volume at /data.
DATABASE_URL=file:/data/dev.db

# Comma-separated exact storefront origins. Never use * in production.
ALLOWED_ORIGINS=https://lazycustoms.com,https://www.lazycustoms.com,https://lazy-customs-2.myshopify.com,https://vbw9zu-f7.myshopify.com

# Long random value used to hash rate-limit identifiers before database storage.
RATE_LIMIT_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
IMAGE_SESSION_LIMIT=3
IMAGE_IP_LIMIT=10
IMAGE_RATE_WINDOW_SECONDS=3600

# Shopify OAuth / App Configuration
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID
SHOPIFY_API_SECRET=YOUR_APP_CLIENT_SECRET
SCOPES=write_products,read_orders,read_customers

# Application & Authentication Redirect URL
REDIRECT_URL=https://ai.lazycustoms.com/auth/callback
