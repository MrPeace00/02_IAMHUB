<div
  id="lazy-home-{{ block.id }}"
  class="lazy-home"
  data-lazy-home
  data-backend-url="{{ block.settings.app_url | escape }}"
  data-shop-id="{{ shop.id }}"
>
  <main class="lazy-home__surface">
    <div class="lazy-home__start">
      <p class="lazy-home__eyebrow">CUSTOM, WITHOUT THE COMPLICATED</p>
      <h1 class="lazy-home__wordmark" aria-label="Lazy Customs">Lazy<span>.</span></h1>
      <p class="lazy-home__intro">Tell us what you have in mind.</p>

      <div class="lazy-home__image-doors" aria-label="Custom image options">
        <button class="lazy-home__image-door" data-lazy-art-start type="button">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8"></path>
          </svg>
          <span>Create with OpenAI</span>
        </button>
        <label class="lazy-home__image-door" for="lazy-home-upload-{{ block.id }}">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 16V4M7 9l5-5 5 5M5 20h14"></path>
          </svg>
          <span>Upload for Claude</span>
        </label>
        <input
          class="lazy-home__sr-only"
          id="lazy-home-upload-{{ block.id }}"
          data-lazy-image-upload
          type="file"
          accept="image/png,image/jpeg,image/webp"
        >
      </div>

      <form class="lazy-home__quiz" data-lazy-quiz-form>
        <p class="lazy-home__quiz-title">A few quick details, then we'll find your picks.</p>
        <div class="lazy-home__quiz-grid">
          <label class="lazy-home__quiz-field">
            <span>Name (optional)</span>
            <input type="text" data-quiz-name maxlength="60" autocomplete="off">
          </label>
          <label class="lazy-home__quiz-field">
            <span>Age (optional)</span>
            <input type="number" data-quiz-age min="0" max="120">
          </label>
          <label class="lazy-home__quiz-field">
            <span>Who's it for</span>
            <select data-quiz-audience>
              <option value="">Select…</option>
              <option value="man">Man</option>
              <option value="woman">Woman</option>
              <option value="child">Child</option>
            </select>
          </label>
          <label class="lazy-home__quiz-field">
            <span>Season</span>
            <select data-quiz-season>
              <option value="">Select…</option>
              <option value="summer">Summer</option>
              <option value="fall">Fall</option>
              <option value="winter">Winter</option>
              <option value="spring">Spring</option>
            </select>
          </label>
          <label class="lazy-home__quiz-field">
            <span>Product type</span>
            <select data-quiz-category>
              <option value="">Select…</option>
              <option value="shirt">Shirt</option>
              <option value="hoodie">Hoodie</option>
              <option value="sweatshirt">Sweatshirt</option>
              <option value="mug">Mug</option>
              <option value="tote bag">Tote Bag</option>
              <option value="candle">Candle</option>
              <option value="wall art">Wall Art</option>
              <option value="baby">Baby / Nursery</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label class="lazy-home__quiz-field">
            <span>Design type</span>
            <select data-quiz-customization>
              <option value="">Select…</option>
              <option value="text-only">Text only</option>
              <option value="image-only">Image only</option>
              <option value="text-on-image">Text on top of image</option>
            </select>
          </label>
        </div>
        <button class="lazy-home__quiz-submit" type="submit">Find my picks</button>
      </form>

      <p class="lazy-home__or">Or describe exactly what you want</p>

      <form class="lazy-home__form" data-lazy-form>
        <label class="lazy-home__sr-only" for="lazy-home-input-{{ block.id }}">
          Search products or describe custom artwork
        </label>
        <div class="lazy-home__search-shell">
          <svg class="lazy-home__search-icon" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input
            id="lazy-home-input-{{ block.id }}"
            data-lazy-input
            type="text"
            maxlength="1000"
            autocomplete="off"
            placeholder="A winter hoodie with text over an image…"
          >
          <button class="lazy-home__send" data-lazy-send type="submit" aria-label="Send">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </form>

      <p class="lazy-home__status" data-lazy-status role="status" aria-live="polite"></p>
      <div class="lazy-home__chips" data-lazy-chips aria-label="Suggestions"></div>
    </div>

    <section class="lazy-home__results" data-lazy-results aria-label="Conversation" hidden>
      <div class="lazy-home__messages" data-lazy-messages aria-live="polite"></div>
      <div class="lazy-home__products" data-lazy-products></div>
    </section>
  </main>
</div>

{% schema %}
{
  "name": "Lazy AI home",
  "target": "section",
  "stylesheet": "lazy-home.css",
  "javascript": "lazy-home.js",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App backend URL",
      "info": "The public HTTPS origin for the Railway app.",
      "default": "https://ai.lazycustoms.com"
    }
  ]
}
{% endschema %}
