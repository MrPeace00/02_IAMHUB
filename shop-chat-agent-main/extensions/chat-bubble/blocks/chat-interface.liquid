{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div class="shop-ai-chat-container">
  <button
    type="button"
    class="shop-ai-chat-bubble"
    style="background-color: {{ block.settings.chat_bubble_color }}"
    aria-label="Open Lazy Chat"
  >
    <img
      class="shop-ai-chat-hub shop-ai-chat-hub--launcher"
      src="{{ 'lazy-chat-hub.png' | asset_url }}"
      alt=""
      width="48"
      height="48"
    >
  </button>

  <div class="shop-ai-chat-window">
    <div class="shop-ai-chat-header">
      <div class="shop-ai-chat-brand">
        <img
          class="shop-ai-chat-hub shop-ai-chat-hub--header"
          src="{{ 'lazy-chat-hub.png' | asset_url }}"
          alt=""
          width="34"
          height="34"
        >
        <span>{{ 'chat.title' | t }}</span>
      </div>
      <button type="button" class="shop-ai-chat-close" aria-label="{{ 'chat.closeButton' | t }}">✕</button>
    </div>

    <div class="shop-ai-chat-messages">
      <!-- Messages will be added here by JavaScript -->
    </div>

    <div class="shop-ai-shopping-start" aria-label="Start shopping">
      <button type="button" data-shop-ai-printify>Shop Printify shirts</button>
      <span>Choose your product first, then explore personalization.</span>
    </div>

    <div class="shop-ai-chat-input">
      <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
      <button class="shop-ai-chat-send">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: "Heyyy",
    appUrl: {{ block.settings.app_url | json }}
  };
  window.shopId = {{ shop.id }};
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App backend URL",
      "info": "Required: the running app's public HTTPS origin.",
      "default": "https://ai.lazycustoms.com"
    },
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Chat Bubble Color",
      "default": "#5046e4"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "Heyyy"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "System Prompt",
      "options": [
        {
          "value": "standardAssistant",
          "label": "Standard Assistant"
        },
        {
          "value": "enthusiasticAssistant",
          "label": "Enthusiastic Assistant"
        }
      ],
      "default": "standardAssistant"
    }
  ]
}
{% endschema %}
